# =============================================================================
# DNSight Backend Environment Variables Example
# 
# Copy this file to '.env' and fill in the values appropriately.
# =============================================================================

# -----------------------------------------------------------------------------
# Celery Configuration
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=your-CELERY_BROKER_URL
CELERY_RESULT_BACKEND=your-CELERY_RESULT_BACKEND

# -----------------------------------------------------------------------------
# URLs Configuration
# -----------------------------------------------------------------------------
# Used for ALLOWED_HOSTS and CORS_ALLOWED_ORIGINS in production
BACKEND_URL=https://dnsight-backend.onrender.com
FRONTEND_URL=https://dnsight-frontend.vercel.app

# -----------------------------------------------------------------------------
# External Services
# -----------------------------------------------------------------------------
# ML Prediction Microservice URL
ML_SERVICE_URL= your-ML_SERVICE_URL

# OpenRouter LLM API Configuration
LLM_API_URL=your-LLM_API_URL
LLM_API_KEY=your_openrouter_api_key_here
LLM_MODEL=your-LLM_MODEL

# -----------------------------------------------------------------------------
# Email Configuration (Gmail SMTP)
# -----------------------------------------------------------------------------
# The Gmail address you are sending emails from
EMAIL_HOST_USER=your_email@gmail.com
# Your Gmail App Password (NOT your regular account password)
EMAIL_HOST_PASSWORD=your_app_password

# -----------------------------------------------------------------------------
# Cloudinary Configuration
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
